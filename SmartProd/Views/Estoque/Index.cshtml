@model List<Estoque>
@{
    ViewData["Title"] = "Estoque";
    var produtosCriticos = ViewBag.ProdutosCriticos as List<Estoque>;
}

<div class="d-flex justify-content-start gap-3 mb-4">
    <button type="button" class="btn btn-warning text-white fw-bold" data-bs-toggle="modal" data-bs-target="#modalNotaEntrega">
        Registrar Nota de Entrega
    </button>
    <button type="button" class="btn btn-danger fw-bold" data-bs-toggle="modal" data-bs-target="#modalNotaSaida">
        Registrar Nota de Saída
    </button>
</div>

<h2 class="mb-3 fw-bold">Estoque</h2>

<table class="table table-striped table-bordered shadow-sm">
    <thead class="table-light">
        <tr>
            <th>Produto</th>
            <th>Atual</th>
            <th>Mínimo</th>
            <th>Máximo</th>
            <th>Localização</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var minimo = item.Produto?.EstoqueMinimo ?? 0;
            var maximo = item.Produto?.EstoqueMaximo ?? 0;
            var isCritico = item.EstoqueAtual < minimo;
            <tr class="@(isCritico ? "table-danger fw-bold" : "")">
                <td>@item.Produto?.Nome</td>
                <td>@item.EstoqueAtual</td>
                <td>@minimo</td>
                <td>@maximo</td>
                <td>@item.Localizacao</td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal Nota de Entrega -->
<div class="modal fade" id="modalNotaEntrega" tabindex="-1" aria-labelledby="modalNotaEntregaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title fw-bold" id="modalNotaEntregaLabel">Registrar Nota de Entrega</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("_RegistrarNotaEntregaPartial", new SmartProd.Models.NotaEntrega { Itens = new List<SmartProd.Models.ItemNotaEntrega>() })
            </div>
        </div>
    </div>
</div>

<!-- Modal Nota de Saída -->
<div class="modal fade" id="modalNotaSaida" tabindex="-1" aria-labelledby="modalNotaSaidaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="modalNotaSaidaLabel">Registrar Nota de Saída</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("_RegistrarNotaSaidaPartial", new SmartProd.Models.NotaSaida { Itens = new List<SmartProd.Models.ItemNotaSaida>() })
            </div>
        </div>
    </div>
</div>

<!-- Modal para estoque zerado -->
<div class="modal fade" id="estoqueZeradoModal" tabindex="-1" aria-labelledby="estoqueZeradoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="estoqueZeradoModalLabel">Estoque zerado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                Este produto está com estoque zerado e não pode ser selecionado para saída.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

 <!-- Modal Detalhe Nota de Entrega -->
<div class="modal fade" id="modalNotaEntregaDetalhe" tabindex="-1" aria-labelledby="modalNotaEntregaDetalheLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNotaEntregaDetalheLabel">Detalhes da Nota de Entrega</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
               
            </div>
        </div>
    </div>
</div>

 <!-- Modal Detalhe Nota de Saída -->
<div class="modal fade" id="modalNotaSaidaDetalhe" tabindex="-1" aria-labelledby="modalNotaSaidaDetalheLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNotaSaidaDetalheLabel">Detalhes da Nota de Saída</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                
            </div>
        </div>
    </div>
</div>

@if (produtosCriticos != null && produtosCriticos.Any())
{
    <div class="alert alert-danger fw-semibold mt-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Atenção:</strong> Existem produtos com estoque abaixo do mínimo!
    </div>
}
