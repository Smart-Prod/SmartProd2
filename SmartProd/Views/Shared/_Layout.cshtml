<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartProd</title>
    <link rel="icon" type="image/svg" href="~/smartprodcls.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> 
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/SmartProd.styles.css" asp-append-version="true" /> *@ 
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">  *@

</head>
<body>
    <header class="headerup">
        <nav class="navbar">
            <div class="divheader">                
				<a asp-area="" asp-controller="Home" asp-action="Index"><img src="~/Logo.png" alt="Logo" /></a>				             
                <div> 
                    <ul>
                        @{
                            if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                <li>
                                    <a  asp-controller="Dashboard" asp-action="Index">Home</a>
                                </li>
                                <li >
                                    <a  asp-area="" asp-controller="Produtos" asp-action="Index">Produto</a>
                                </li>                                
                                <li >
                                    <a  asp-area="" asp-controller="Estoque" asp-action="Index">Estoque</a>
                                </li>                                                            
                                <li >
                                    <a  asp-area="" asp-controller="Relatorio" asp-action="Index">Relatórios</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul >
                        @{
                            if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                <li >
                                  <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">                                    
                                    Olá @User.Identity.Name
                                  </a>
                                    <ul >
                                        <li><a  asp-area="" asp-controller="" asp-action="">Conta</a></li>                                        
                                        <li><a  asp-area="" asp-controller="Account" asp-action="Logout">Sair</a></li>
                                    </ul>
                                </li>
                                
                            }
                            else
                            {
                                <li>
                                    <a  asp-area="" asp-controller="Empresa" asp-action="Cadastrar">Criar</a>
                                </li>
                                <li>
                                    <a  asp-area="" asp-controller="Account" asp-action="Login">Entrar</a>
                                </li>

                            }
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div>
        
        <main role="main">
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
