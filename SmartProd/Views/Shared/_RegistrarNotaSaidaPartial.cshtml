@model SmartProd.Models.NotaSaida

@{
    ViewData["Title"] = "RegistrarNotaSaida";
}

<h1>RegistrarNotaSaida</h1>

<h4>NotaSaida</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="RegistrarNotaSaida" method="post">
            <div>
                <label>Número da Nota:</label>
                <input asp-for="NumeroNota" class="form-control" />
            </div>
            <div>
                <label>Destino:</label>
                <input asp-for="Destino" class="form-control" />
            </div>

            <h4>Itens da Saída</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Quantidade</th>
                        <th style="width: 170px;">Preço Unitário</th>
                        <th style="width: 170px;">Valor Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="itens-saida">
                    <tr>
                        <td>
                            <select name="Itens[0].IdProduto" class="form-control" style="width: 160px;" onchange="atualizarPrecoUnitario(this)">
                                <option value="">-- Selecione --</option>
                                @foreach (var produto in ViewBag.Produtos)
                                {
                                    <option value="@produto.Id" data-preco="@produto.Preco" data-estoque-atual="@produto.EstoqueAtual" data-estoque-minimo="@produto.EstoqueMinimo">@produto.Nome</option>
                                }
                            </select>
                        </td>
                        <td>
                            <input name="Itens[0].Quantidade" type="number" class="form-control" min="1" style="width: 160px;" onchange="validarQuantidadeSaida(this)" />
                        </td>
                        <td>
                            <input name="Itens[0].PrecoUnitario" type="number" class="form-control" style="width: 160px;" readonly />
                        </td>
                        <td>
                            <input name="Itens[0].ValorTotal" type="number" class="form-control" readonly style="width: 160px;" />
                        </td>
                        <td>
                            <button type="button" class="btn btn-danger btn-remover-item" onclick="removerItemSaida(this)" style="display: none;">X</button>
                        </td>
                    </tr>
                </tbody>
            </table>
            <button type="button" onclick="adicionarItemSaida()">Adicionar Item</button>

            <br /><br />
            <button type="submit" class="btn btn-danger">Salvar Nota de Saída</button>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
    // Opções de produtos com data-preco para cada option
    const produtosSaidaHtml = `@Html.Raw(
    string.Join("",
        ((ViewBag.Produtos as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>())
        .Select(p => $"<option value='{p.Id}' data-preco='{p.Preco}' data-estoque-atual='{p.EstoqueAtual}' data-estoque-minimo='{p.EstoqueMinimo}'>{System.Net.WebUtility.HtmlEncode(p.Nome)}</option>")
    ))`;
    let indexSaida = 1;
    function adicionarItemSaida() {
        const tbody = document.getElementById('itens-saida');
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>
                <select name="Itens[${indexSaida}].IdProduto" class="form-control" required style="width: 160px;" onchange="atualizarPrecoUnitario(this)">
                    <option value="">-- Selecione --</option>
                    ${produtosSaidaHtml}
                </select>
            </td>
            <td>
                <input name="Itens[${indexSaida}].Quantidade" type="number" class="form-control" required min="1" style="width: 160px;" onchange="validarQuantidadeSaida(this)" />
            </td>
            <td>
                <input name="Itens[${indexSaida}].PrecoUnitario" type="number" class="form-control" style="width: 160px;" readonly />
            </td>
            <td>
                <input name="Itens[${indexSaida}].ValorTotal" type="number" class="form-control" readonly style="width: 160px;" />
            </td>
            <td>
                <button type="button" class="btn btn-danger btn-remover-item" onclick="removerItemSaida(this)">X</button>
            </td>
        `;
        tbody.appendChild(row);
        indexSaida++;
        atualizarVisibilidadeRemoverSaida();
    }

    function removerItemSaida(btn) {
        const row = btn.closest('tr');
        row.remove();
        atualizarNomesItensSaida();
        atualizarVisibilidadeRemoverSaida();
    }

    function atualizarNomesItensSaida() {
        const rows = document.querySelectorAll('#itens-saida tr');
        rows.forEach((row, idx) => {
            const select = row.querySelector('select');
            const quantidade = row.querySelector('input[name$=".Quantidade"]');
            const preco = row.querySelector('input[name$=".PrecoUnitario"]');
            const valor = row.querySelector('input[name$=".ValorTotal"]');
            if (select) select.name = `Itens[${idx}].IdProduto`;
            if (quantidade) quantidade.name = `Itens[${idx}].Quantidade`;
            if (preco) preco.name = `Itens[${idx}].PrecoUnitario`;
            if (valor) valor.name = `Itens[${idx}].ValorTotal`;
        });
        indexSaida = rows.length;
    }

    function atualizarVisibilidadeRemoverSaida() {
        const rows = document.querySelectorAll('#itens-saida tr');
        rows.forEach(row => {
            const removerBtn = row.querySelector('.btn-remover-item');
            if (removerBtn) {
                removerBtn.style.display = (rows.length > 1) ? '' : 'none';
            }
        });
    }
     function validarQuantidadeSaida(input) {
        const row = input.closest('tr');
        const select = row.querySelector('select');
        const selectedOption = select.options[select.selectedIndex];

        // Só valida se produto está selecionado
        if (!selectedOption || !selectedOption.value) {
            input.value = '';
            atualizarValorTotalSaida(input);
            return;
        }

        let quantidade = parseFloat(input.value) || 0;

        // Não permite valor negativo
        if (quantidade < 0) {
            input.value = 0;
            quantidade = 0;
        }
        atualizarValorTotalSaida(input);
    }

    function atualizarPrecoUnitario(select) {
        const row = select.closest('tr');
        const selectedOption = select.options[select.selectedIndex];

        if (!selectedOption || !selectedOption.value) {
            // Limpa campos se nada selecionado
            row.querySelector('input[name$=".PrecoUnitario"]').value = '';
            row.querySelector('input[name$=".ValorTotal"]').value = '';
            return;
        }

        const estoqueAtualAttr = selectedOption.getAttribute('data-estoque-atual');
        const estoqueAtual = estoqueAtualAttr !== null && estoqueAtualAttr !== '' ? Number(estoqueAtualAttr) : null;

        if (estoqueAtual !== null && estoqueAtual <= 0) {
        // Limpa seleção e campos
        select.value = '';
        row.querySelector('input[name$=".PrecoUnitario"]').value = '';
        row.querySelector('input[name$=".Quantidade"]').value = '';
        row.querySelector('input[name$=".ValorTotal"]').value = '';
        // Mostra o modal
        if (window.bootstrap && bootstrap.Modal) {
            var modal = new bootstrap.Modal(document.getElementById('estoqueZeradoModal'));
            modal.show();
        } else {
            $('#estoqueZeradoModal').modal('show');
        }
        return;
        }
    

        const preco = selectedOption.getAttribute('data-preco') || 0;
        const precoInput = row.querySelector('input[name$=".PrecoUnitario"]');
        precoInput.value = parseFloat(preco).toFixed(2);
        atualizarValorTotalSaida(precoInput);
    }

    function atualizarValorTotalSaida(input) {
        const row = input.closest('tr');
        const quantidade = parseFloat(row.querySelector('input[name$=".Quantidade"]').value) || 0;
        const preco = parseFloat(row.querySelector('input[name$=".PrecoUnitario"]').value) || 0;
        const valorTotal = row.querySelector('input[name$=".ValorTotal"]');
        valorTotal.value = (quantidade * preco).toFixed(2);
    }

    document.addEventListener('DOMContentLoaded', () => {
        atualizarVisibilidadeRemoverSaida();
        // Preenche o preço unitário inicial dos selects já existentes
        document.querySelectorAll('#itens-saida select').forEach(sel => atualizarPrecoUnitario(sel));
    });
</script>
