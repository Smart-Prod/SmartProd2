@model SmartProd.Models.NotaSaida

<div class="modal fade" id="modalNotaSaidaDetalhe" tabindex="-1" aria-labelledby="modalNotaSaidaDetalheLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNotaSaidaDetalheLabel">Detalhes da Nota de Saída</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <h4>Nota de Saída: @Model.NumeroNota</h4>
                <p><b>Data:</b> @Model.DataSaida.ToString("dd/MM/yyyy")</p>
                <p><b>Destinatário:</b> @Model.Cliente</p>
                <h5>Itens</h5>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Quantidade</th>
                            <th>Valor Unitário</th>
                            <th>Valor Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Itens)
                        {
                            <tr>
                                <td>@item.Produto?.Nome</td>
                                <td>@item.Quantidade</td>
                                <td>@item.PrecoUnitario.ToString("C")</td>
                                <td>@(item.Quantidade * item.PrecoUnitario).ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>