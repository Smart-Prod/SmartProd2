@model SmartProd.Models.Produto

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Produto</h4>
    <hr />
    <dl class="row">
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Imagem)
		</dt>
		<dd class="col-sm-10">
            <img src="@("/" + Model.Imagem)" alt="Model.Nome" class="img-fluid" style="width:200px;height:200px;" />
		</dd>        
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Categoria)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Categoria)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Preco)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Preco)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EstoqueMaximo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EstoqueMaximo)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EstoqueMinimo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EstoqueMinimo)
        </dd>
        
       
        
        
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> | |
    <a asp-action="Index">Back to List</a>
</div>
