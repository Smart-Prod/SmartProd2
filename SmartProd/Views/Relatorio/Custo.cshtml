@model List<NotaEntrega>
@{
    ViewData["Title"] = "Relatório de Custo de Estoque";
    decimal totalCusto = ViewBag.TotalCusto ?? 0;
}
<h2>Relatório de Custo de Estoque</h2>
<p><strong>Total de Custo no Período:</strong> @totalCusto.ToString("C")</p>
<table class="table">
    <thead>
        <tr>
            <th>Nota</th>
            <th>Data</th>
            <th>Fornecedor</th>
            <th>Itens</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var nota in Model)
        {
            <tr>
                <td>@nota.NumeroNota</td>
                <td>@nota.DataEntrega.ToShortDateString()</td>
                <td>@nota.Fornecedor</td>
                <td>
                    <ul>
                        @foreach (var item in nota.Itens)
                        {
                            <li>
                                @item.Produto?.Nome - @item.Quantidade un. - @item.CustoUnitario.ToString("C") un. - @item.ValorTotal.ToString("C") total
                            </li>
                        }
                    </ul>
                </td>
            </tr>
        }
    </tbody>
</table>