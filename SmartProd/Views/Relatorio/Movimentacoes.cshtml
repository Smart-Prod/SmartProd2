@model List<MovimentacaoViewModel>
@{
    ViewData["Title"] = "Movimentações de Estoque";
}

<h2>Movimentações de Estoque</h2>
<form method="get" class="mb-3">
    <label>De: <input type="date" name="dataInicial" value="@ViewBag.DataInicial" /></label>
    <label>Até: <input type="date" name="dataFinal" value="@ViewBag.DataFinal" /></label>
    <button type="submit" class="btn btn-primary">Filtrar</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Nota</th>
            <th>Data</th>
            <th>Fornecedor/Cliente</th>
            <th>Itens</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mov in Model)
        {
            <tr>
                <td>@mov.Tipo</td>
                <td>@mov.NumeroNota</td>
                <td>@mov.Data.ToShortDateString()</td>
                <td>@mov.FornecedorOuCliente</td>
                <td>
                    <ul>
                        @foreach (var item in mov.Itens)
                        {
                            <li>@item.ProdutoNome - @item.Quantidade un.</li>
                        }
                    </ul>
                </td>
            </tr>
        }
    </tbody>
</table>

<canvas id="graficoMovimentacoes"></canvas>
@section Scripts {
    <script>
        // Agrupe por produto e tipo
        var entradas = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Where(x => x.Tipo == "Entrada").SelectMany(m => m.Itens)));
        var saidas = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Where(x => x.Tipo == "Saída").SelectMany(m => m.Itens)));
        // Crie lógica JS para agrupar por produto e somar quantidades

        // Exemplo simplificado: obtenha nomes únicos
        var nomesProdutos = [...new Set([...entradas.map(i => i.ProdutoNome), ...saidas.map(i => i.ProdutoNome)])];
        var dadosEntradas = nomesProdutos.map(n => entradas.filter(i => i.ProdutoNome === n).reduce((acc, v) => acc + v.Quantidade, 0));
        var dadosSaidas = nomesProdutos.map(n => saidas.filter(i => i.ProdutoNome === n).reduce((acc, v) => acc + v.Quantidade, 0));

        var ctx = document.getElementById('graficoMovimentacoes').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: nomesProdutos,
                datasets: [
                    { label: 'Entradas', data: dadosEntradas, backgroundColor: 'rgba(75, 192, 192, 0.6)' },
                    { label: 'Saídas', data: dadosSaidas, backgroundColor: 'rgba(255, 99, 132, 0.6)' }
                ]
            },
            options: { responsive: true }
        });
    </script>
}