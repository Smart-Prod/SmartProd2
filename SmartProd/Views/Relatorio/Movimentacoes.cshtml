@model dynamic
@{
    ViewData["Title"] = "Movimentações de Estoque";
    var entradas = Model.Entradas as List<NotaEntrega>;
    var saidas = Model.Saidas as List<NotaSaida>;
}
<h2>Entradas</h2>

<form method="get" class="mb-3">
    <label>De: <input type="date" name="dataInicial" value="@ViewBag.DataInicial" /></label>
    <label>Até: <input type="date" name="dataFinal" value="@ViewBag.DataFinal" /></label>
    <button type="submit" class="btn btn-primary">Filtrar</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Nota</th>
            <th>Data</th>
            <th>Fornecedor</th>
            <th>Itens</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var nota in entradas)
        {
            <tr>
                <td>@nota.NumeroNota</td>
                <td>@nota.DataEntrega.ToShortDateString()</td>
                <td>@nota.Fornecedor</td>
                <td>
                    <ul>
                        @foreach (var item in nota.Itens)
                        {
                            <li>@item.Produto?.Nome - @item.Quantidade un.</li>
                        }
                    </ul>
                </td>
            </tr>
        }
    </tbody>
</table>