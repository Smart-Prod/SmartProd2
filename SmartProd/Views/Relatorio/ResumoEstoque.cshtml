@model dynamic
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Resumo de Estoque";
    var saldo = Model.Saldo as List<EstoqueProdutoViewModel>;
    var inventario = Model.Inventario as IEnumerable<dynamic>;
    var minimos = Model.Minimos as List<Produto>;
    var maximos = Model.Maximos as List<Produto>;

    // Projeção para o gráfico
    var nomesSaldo = saldo.Select(x => x.Nome).ToList();
    var estoquesSaldo = saldo.Select(x => x.EstoqueAtual).ToList();
}


<h1>Resumo de Estoque</h1>
<a asp-action="Index">Voltar</a>

<h2>Saldo de Estoque</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Produto</th>
            <th>Estoque Atual</th>
            <th>Estoque Mínimo</th>
            <th>Estoque Máximo</th>
            <th>Estoque Baixo?</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in saldo)
        {
            <tr class="@(item.EstoqueBaixo ? "table-danger" : "")">
                <td>@item.Nome</td>
                <td>@item.EstoqueAtual</td>
                <td>@item.EstoqueMinimo</td>
                <td>@item.EstoqueMaximo</td>
                <td>@(item.EstoqueBaixo ? "Sim" : "Não")</td>
            </tr>
        }
    </tbody>
</table>

<h2>Inventário</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Produto</th>
            <th>Categoria</th>
            <th>Estoque Atual</th>
            <th>Localização</th>
            <th>Última Atualização</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in inventario)
        {
            <tr>
                <td>@item.Produto?.Nome</td>
                <td>@item.Produto?.Categoria</td>
                <td>@item.EstoqueAtual</td>
                <td>@item.Localizacao</td>
                <td>@item.DataUltimaAtualizacao.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>
@if (saldo.Any())
{
    <canvas id="graficoSaldo"></canvas>
    @section Scripts {
    <script>
        var nomesSaldo = @Html.Raw(JsonConvert.SerializeObject(nomesSaldo));
        var estoquesSaldo = @Html.Raw(JsonConvert.SerializeObject(estoquesSaldo));
        var ctx = document.getElementById('graficoSaldo').getContext('2d');
        var chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: nomesSaldo,
                datasets: [{
                    label: 'Estoque Atual',
                    data: estoquesSaldo,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)'
                }]
            },
            options: { responsive: true }
        });
    </script>
    }
}