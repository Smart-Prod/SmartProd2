@model List<Produto>
@{
    ViewData["Title"] = "Produtos Parados";
}
<h2>Produtos Parados (Obsoletos)</h2>
@if (Model.Count == 0)
{
    <div class="alert alert-success">Nenhum produto parado encontrado no período.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Categoria</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Nome</td>
                    <td>@p.Categoria</td>
                </tr>
            }
        </tbody>
    </table>
}
