@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    var movimentacoes = Model.MovimentacoesPorNota as IEnumerable<dynamic> ?? new List<dynamic>();

    // Separar por tipo
    var notas = movimentacoes.Select(x => (string)x.NumeroNota).Distinct().ToList();
    var entradas = notas
        .Select(nota => movimentacoes.Where(x => x.NumeroNota == nota && x.Tipo == "Entrada").Sum(x => (int)x.Quantidade))
        .ToList();
    var saidas = notas
        .Select(nota => movimentacoes.Where(x => x.NumeroNota == nota && x.Tipo == "Saída").Sum(x => (int)x.Quantidade))
        .ToList();
}

<h2>📊 Dashboard</h2>
<div class="dashboard">
    <div class="dashboard-box">
        <img src="~/img/src/produto.png" alt="Produto Image" class="img-fluid" />
        <p>Total de produtos cadastrados:</p>
        <p> @Model.TotalProdutosCadastrados</p>

    </div>
    <div class="dashboard-box">
        <img src="~/img/src/estoque.png" alt="Estoque Image" class="img-fluid" />
        <p>Total atual em estoque:</p>
        <p> @Model.TotalEstoque</p>
    </div>
    <div class="dashboard-box">
        <img src="~/img/src/entrada.png" alt="Entrada Image" class="img-fluid" />
        <p>Total entradas:</p>
        <p> @Model.TotalEntradas</p>
    </div>
    <div class="dashboard-box">
        <img src="~/img/src/saida.png" alt="Saída Image" class="img-fluid" />
        <p>Total saídas:</p>
        <p> @Model.TotalSaidas</p>
    </div>

</div>

<h3>Movimentações por Nota</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Número da Nota</th>
            <th>Data</th>
            <th>Quantidade</th>
            <th>Tipo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mov in Model.MovimentacoesPorNota!)
        {
            <tr>
                <td>
                    @if (mov.Tipo == "Entrada")
                    {
                        <a href="#" class="link-nota" data-notaid="@mov.NotaId">@mov.NumeroNota</a>
                    }
                    else
                    {
                        <a href="#" class="link-nota-saida" data-notaid="@mov.NotaId">@mov.NumeroNota</a>
                    }
                </td>
                <td>@mov.DataNota.ToString("dd/MM/yyyy")</td>
                <td>@mov.Quantidade</td>
                <td>@mov.Tipo</td>
            </tr>
        }
    </tbody>
</table>

<div class="grafico">
    <canvas id="graficoMovPorNota"></canvas>
    <canvas id="graficoCusto"></canvas>
    <canvas id="graficoFatuaramento"></canvas>
    <canvas id="graficoSaldo"></canvas>
</div>


<div class="modal fade" id="modalNotaEntregaDetalhe" tabindex="-1" aria-labelledby="modalNotaEntregaDetalheLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNotaEntregaDetalheLabel">Detalhes da Nota de Entrega</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalNotaSaidaDetalhe" tabindex="-1" aria-labelledby="modalNotaSaidaDetalheLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNotaSaidaDetalheLabel">Detalhes da Nota de Saída</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
         // Gráfico Movimentação por Nota
        var ctx = document.getElementById('graficoMovPorNota').getContext('2d');
        var chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(notas)),
                datasets: [
                    {
                        label: 'Entradas',
                        data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(entradas)),
                        backgroundColor: 'rgba(54, 162, 235, 0.6)'
                    },
                    {
                        label: 'Saídas',
                        data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(saidas)),
                        backgroundColor: 'rgba(255, 99, 132, 0.6)'
                    }
                ]
            },
            options: {
                responsive: true,
                scales: {
                    x: { stacked: true },
                    y: { beginAtZero: true, stacked: true }
                }
            }
        });


    </script>
}