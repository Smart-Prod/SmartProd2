@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2>📊 Dashboard</h2>
<div class="dashboard">
    <div class="dashboard-box">
		<img src="~/img/src/produto.png" alt="Produto Image" class="img-fluid" />
        <p>Total de produtos cadastrados:</p>
		<p> @Model.TotalProdutosCadastrados</p>
    </div>
    <div class="dashboard-box">
		<img src="~/img/src/estoque.png" alt="Estoque Image" class="img-fluid" />
        <p>Total atual em estoque:</p>
		<p> @Model.TotalEstoque</p>
    </div>
	<div class="dashboard-box">
		<img src="~/img/src/entrada.png" alt="Entrada Image" class="img-fluid" />
        <p>Total entradas:</p>
		<p> @Model.TotalEntradas</p>
    </div >
	<div class ="dashboard-box">
		<img src="~/img/src/saida.png" alt="Saída Image" class="img-fluid" />
        <p>Total saídas:</p>
		<p> @Model.TotalSaidas</p>
    </div>
   
</div>

<h3>Movimentações por Nota</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Número da Nota</th>
            <th>Data</th>
            <th>Quantidade</th>
            <th>Tipo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mov in Model.MovimentacoesPorNota)
        {
            <tr>
                <td>
                    @if (mov.Tipo == "Entrada")
                    {
                        <a href="#" class="link-nota" data-notaid="@mov.NotaId">@mov.NumeroNota</a>
                    }
                    else
                    {
                        <a href="#" class="link-nota-saida" data-notaid="@mov.NotaId">@mov.NumeroNota</a>
                    }
                </td>
                <td>@mov.DataNota.ToString("dd/MM/yyyy")</td>
                <td>@mov.Quantidade</td>
                <td>@mov.Tipo</td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal de Detalhes (mesmo modal já existente) -->
<div class="modal fade" id="modalNotaDetalhes" tabindex="-1" aria-labelledby="modalNotaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="conteudo-modal-imprimir">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNotaLabel">Detalhes da Nota</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body" id="modalNotaBody">
                <!-- Conteúdo AJAX -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="imprimirNota()">Imprimir</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Clique para mostrar detalhes da nota de entrada (já existe)
        $(document).on('click', '.link-nota', function (e) {
            e.preventDefault();
            var notaId = $(this).data('notaid');
            $('#modalNotaBody').html('<div class="text-center"><span class="spinner-border"></span></div>');
            $('#modalNotaDetalhes').modal('show');
            $.get('@Url.Action("DetalhesNotaEntrada", "Dashboard")', { id: notaId }, function (data) {
                $('#modalNotaBody').html(data);
            });
        });

        // Clique para mostrar detalhes da nota de saída (novo)
        $(document).on('click', '.link-nota-saida', function (e) {
            e.preventDefault();
            var notaId = $(this).data('notaid');
            $('#modalNotaBody').html('<div class="text-center"><span class="spinner-border"></span></div>');
            $('#modalNotaDetalhes').modal('show');
            $.get('@Url.Action("DetalhesNotaSaida", "Dashboard")', { id: notaId }, function (data) {
                $('#modalNotaBody').html(data);
            });
        });

        function imprimirNota() {
            var printContents = document.getElementById('conteudo-modal-imprimir').innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
            location.reload();
        }
    </script>
}