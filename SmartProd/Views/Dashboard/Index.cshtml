@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2>📊 Dashboard</h2>
<div class="dashboard">
    <div class="dashboard-box">
		<img src="~/img/src/produto.png" alt="Produto Image" class="img-fluid" />
        <p>Total de produtos cadastrados:</p>
		<p> @Model.TotalProdutosCadastrados</p>
        
    </div>
    <div class="dashboard-box">
		<img src="~/img/src/estoque.png" alt="Estoque Image" class="img-fluid" />
        <p>Total atual em estoque:</p>
		<p> @Model.TotalEstoque</p>
    </div>
	<div class="dashboard-box">
		<img src="~/img/src/entrada.png" alt="Entrada Image" class="img-fluid" />
        <p>Total entradas:</p>
		<p> @Model.TotalEntradas</p>
    </div >
	<div class ="dashboard-box">
		<img src="~/img/src/saida.png" alt="Saída Image" class="img-fluid" />
        <p>Total saídas:</p>
		<p> @Model.TotalSaidas</p>
    </div>
   
</div>

<h3>Movimentações por Nota</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Número da Nota</th>
            <th>Data</th>
            <th>Quantidade</th>
            <th>Tipo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mov in Model.MovimentacoesPorNota)
        {
            <tr>
                <td>
                    @if (mov.Tipo == "Entrada")
                    {
                        <a href="#" class="link-nota" data-notaid="@mov.NotaId">@mov.NumeroNota</a>
                    }
                    else
                    {
                        <a href="#" class="link-nota-saida" data-notaid="@mov.NotaId">@mov.NumeroNota</a>
                    }
                </td>
                <td>@mov.DataNota.ToString("dd/MM/yyyy")</td>
                <td>@mov.Quantidade</td>
                <td>@mov.Tipo</td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal Detalhe Nota de Entrega -->
<div class="modal fade" id="modalNotaEntregaDetalhe" tabindex="-1" aria-labelledby="modalNotaEntregaDetalheLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNotaEntregaDetalheLabel">Detalhes da Nota de Entrega</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("_DetalhesNotaEntrega", Model.NotaEntrega)
            </div>
        </div>
    </div>
</div>

<!-- Modal Detalhe Nota de Saída -->
<div class="modal fade" id="modalNotaSaidaDetalhe" tabindex="-1" aria-labelledby="modalNotaSaidaDetalheLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNotaSaidaDetalheLabel">Detalhes da Nota de Saída</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("_DetalhesNotaSaida", Model.NotaSaida)
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
    // Para nota de entrega
$(document).on('click', '.link-nota-entrada', function (e) {
    e.preventDefault();
    var notaId = $(this).data('notaid');
    $('#detalheNotaEntregaBody').html('<div class="text-center"><span class="spinner-border"></span></div>');
    $('#modalNotaEntregaDetalhe').modal('show');
    $.get('@Url.Action("DetalhesNotaEntrada", "Dashboard")', { id: notaId }, function (data) {
        $('#detalheNotaEntregaBody').html(data);
    });
});

// Para nota de saída
$(document).on('click', '.link-nota-saida', function (e) {
    e.preventDefault();
    var notaId = $(this).data('notaid');
    $('#detalheNotaSaidaBody').html('<div class="text-center"><span class="spinner-border"></span></div>');
    $('#modalNotaSaidaDetalhe').modal('show');
    $.get('@Url.Action("DetalhesNotaSaida", "Dashboard")', { id: notaId }, function (data) {
        $('#detalheNotaSaidaBody').html(data);
    });
});

// Funções de imprimir para cada modal
function imprimirNotaEntrada() {
    var printContents = document.getElementById('conteudo-modal-imprimir-entrada').innerHTML;
    var originalContents = document.body.innerHTML;
    document.body.innerHTML = printContents;
    window.print();
    document.body.innerHTML = originalContents;
    location.reload();
}
function imprimirNotaSaida() {
    var printContents = document.getElementById('conteudo-modal-imprimir-saida').innerHTML;
    var originalContents = document.body.innerHTML;
    document.body.innerHTML = printContents;
    window.print();
    document.body.innerHTML = originalContents;
    location.reload();
}
    </script>
}