@model SmartProd.Models.Empresa

@{
    ViewData["Title"] = "Cadastro";
}

<body>

    <div class="container">
        <div class="login-box">
            <img src="logo.png" alt="SmartProd Logo" class="logo">

            <form action="/Login/Entrar" method="post">
                <div class="input-group">
                    <label for="usuario">Usuário</label>
                    <input type="text" id="usuario" name="usuario" placeholder="Usuário" required>
                </div>

                <div class="input-group">
                    <label for="senha">Senha</label>
                    <input type="password" id="senha" name="senha" placeholder="Senha" required>
                </div>

                <a href="#" class="link">Esqueci minha senha</a>

                <button type="submit" class="btn">Entrar</button>

                <p class="versao">Versão 1.0.0</p>
            </form>
        </div>

        <div class="banner">
            <h1>&lt;SmartProd&gt;</h1>
            <p>Sua gestão inteligente de produção</p>
        </div>
    </div>

</body>





@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
