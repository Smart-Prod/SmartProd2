@model SmartProd.Models.Empresa

@{
    ViewData["Title"] = "Cadastro";
}

<div class="cadastro-container">
    <div class="cadastro-logo">
        <img src="/Logo.png" alt="SmartProd" />
    </div>

    <div class="form-container">
        <div class="cadastro-header">
            <h1>Cadastro de Empresa</h1>
        </div>

        <form asp-action="Cadastrar" method="post" id="formEmpresa">
            <div class="cadastro-form-group">
                <label asp-for="Cnpj"></label>
                <input asp-for="Cnpj" id="Cnpj" />
                <span asp-validation-for="Cnpj"></span>
                <button type="button" onclick="buscarCnpj()" class="cadastro-buscar-btn">Buscar CNPJ</button>
            </div>

            <div class="cadastro-form-group">
                <label asp-for="RazaoSocial"></label>
                <input asp-for="RazaoSocial" id="RazaoSocial" />
                <span asp-validation-for="RazaoSocial"></span>
            </div>

            <div class="cadastro-form-group">
                <label asp-for="NomeFantasia"></label>
                <input asp-for="NomeFantasia" id="NomeFantasia" />
                <span asp-validation-for="NomeFantasia" class="text-danger"></span>
            </div>

            <div class="cadastro-form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" id="Email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="cadastro-form-group">
                <label asp-for="Telefone"></label>
                <input asp-for="Telefone" id="Telefone" />
                <span asp-validation-for="Telefone"></span>
            </div>

            <div class="cadastro-form-group">
                <label asp-for="Password">Senha</label>
                <input asp-for="Password" type="password" />
                <span asp-validation-for="Password" placeholder="Digite uma senha segura" required></span>
            </div>

            <button type="submit" class="cadastro-submit-btn">Cadastrar</button>

            <p class="cadastro-link">
                Já possui uma conta?
                <a asp-controller="Account" asp-action="Login">Entrar</a>
            </p>
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
